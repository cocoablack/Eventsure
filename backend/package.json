{
  "name": "eventsure-api",
  "version": "1.0.0",
  "private": true,
  "description": "EventSure API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js && node --check app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:create": "node src/scripts/createAdmin.js",
    "seed:vendors": "node src/seed/seedVendors.js",
    "seed:bookings": "node src/seed/seedBookings.js",
    "seed:subscriptions": "node src/seed/seedSubscriptions.js"
  },
  "engines": {
    "node": ">=20 <26"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
